@theme "~/.config/rofi/graphite.rasi"

window {
	width: 40%;
}

listview {
    layout: vertical;
    columns: 4;
    lines: 2;
    fixed-height: false;
    spacing: 8px;
}

element {
    orientation: vertical;
    children: [ element-icon, element-text ];
    padding: 16px;
}

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;
    font: "Segoe UI 11";
    text-color: @fg;
    margin: 8px 0px 0px 0px;
}	

element-icon {
    size: 48px;
}

element-text {
    horizontal-align: 0.5;
}

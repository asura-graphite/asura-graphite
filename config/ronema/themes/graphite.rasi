* {
    bg:       #17191c;
    surface:  #24262a;
    selected: #373a40;
    border:   #4b4f55;
    fg:       #d8dadd;
    muted:    #92979f;
    background-color: transparent;
    text-color: @fg;
    font: "Segoe UI 12";
}

window {
    width: 760px;
    location: center;
    anchor: center;
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    padding: 18px;
}

inputbar {
    orientation: horizontal;
    children: [textbox-search, entry];
    background-color: @surface;
    border-radius: 8px;
    padding: 12px 16px;
    spacing: 10px;

}

textbox-search {
    content: "";
    font: "JetBrainsMono Nerd Font 18";
    text-color: @fg;
    background-color: transparent;
    expand: false;
    width: 28px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}


entry {
    background-color: transparent;
    text-color: @muted;
    placeholder: "";
    placeholder-color: @muted;
    font: "Segoe UI 12";
    expand: true;
    vertical-align: 0.5;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 10;
    spacing: 4px;
    scrollbar: false;
    fixed-height: false;
}


element {
    background-color: transparent;
    border-radius: 8px;
    children: [ element-text ];
    padding: 10px;
    spacing: 12px;
    border-radius: 8px;
}

element selected {
    background-color: transparent;
    text-color: @fg;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element alternate.normal {
    background-color: @surface;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected;
    text-color: @fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: "DejaVu Sans Mono 11";
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

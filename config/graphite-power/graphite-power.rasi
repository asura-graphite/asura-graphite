* {
    bg:       #17191c;
    surface:  #24262a;
    selected: #373a40;
    border:   #4b4f55;
    fg:       #d8dadd;
    muted:    #92979f;

    background-color: transparent;
    text-color: @fg;

    font: "Segoe UI 12";
}


window {
    width: 600px;
    background-color: @bg;
    border: 1px;
    border-color: @border;
    border-radius: 12px;
    padding: 18px;
}

mainbox {
    children: [ listview ];
    background-color: transparent;
}

entry {
    vertical-align: 0.5;
    placeholder: "Search";
    placeholder-color: @muted;
    expand: true;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 5px;
}


element {
    orientation: horizontal;
    children: [ element-icon, element-text ];
    padding: 10px;
    spacing: 12px;
    border-radius: 8px;
}

element selected {
    background-color: @selected;
    text-color: @fg;
}

element-icon {
    size: 28px;
}

element-text {
    vertical-align: 0.5;
}
